# ---------------------------------------------------------------------------
# Spartan Tyres — environment variables
#
# Copy to `.env.local` for local development, and set the same keys in the
# Vercel project under Settings → Environment Variables for deployment.
#
# The site is designed to deploy and browse correctly with NONE of these set:
# the storefront runs from the bundled catalogue, Square checkout shows a
# "call us to order" fallback, and the admin panel shows a setup panel instead
# of a login. Nothing crashes on a missing variable.
# ---------------------------------------------------------------------------


# --- Square payments -------------------------------------------------------
# Required for card checkout. Without all three, /api/square/* returns 503 and
# the checkout tells the customer to phone the order through instead.
#
# Get these from https://developer.squareup.com/apps → your application.
# Use the Sandbox credentials while testing, Production when you go live.
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=

# `sandbox` (default) or `production`. This also selects which Square Web
# Payments SDK the browser loads, so it must match the credentials above.
SQUARE_ENVIRONMENT=sandbox

# Offer Afterpay at checkout. Requires Afterpay to be enabled on the Square
# account. Orders above $2,000 are excluded automatically.
SQUARE_AFTERPAY_ENABLED=false


# --- Admin panel -----------------------------------------------------------
# Required to use /admin. While unset, every admin endpoint returns 503 and the
# panel shows a setup panel — it never falls open.
ADMIN_PASSWORD=

# Signs the admin session token. Set this to a long random string
# (e.g. `openssl rand -hex 32`). If omitted it is derived from ADMIN_PASSWORD,
# which means rotating the password invalidates every existing session.
ADMIN_SESSION_SECRET=


# --- Customer accounts ----------------------------------------------------
# Customer sign-in ("My account", private prices, pay later). Needs a Postgres
# database (DATABASE_URL / POSTGRES_URL below) AND ADMIN_SESSION_SECRET above on
# Vercel: without the secret the account endpoints answer 503, never a built-in
# key. Locally it needs neither (a clearly labelled local-only key and the .data/
# database are used).
#
# Email is sent through Resend (https://resend.com). MAIL_FROM must be on a domain
# verified in Resend, e.g. Spartan Tyres <accounts@spartantrucktyres.com.au>.
# Without these nothing is sent; staff are shown the set-password link to copy,
# and locally the emails are kept in a dev outbox (GET /api/account/dev-outbox).
RESEND_API_KEY=
MAIL_FROM=
# MAIL_OUTBOX_FILES=1 also writes the local dev outbox to .data/outbox/.
#
# Links in emails (set password, reset) point at PUBLIC_SITE_URL (see Misc below).


# --- Persistence -----------------------------------------------------------
# Orders, enquiries, newsletter subscribers and stock/price overrides.
#
# STRONGLY RECOMMENDED for production. Serverless filesystems are ephemeral, so
# without these the store falls back to an in-memory map that is wiped on every
# cold start — fine for local development, lossy for real orders.
#
# Connect ONE database in the Vercel dashboard (Storage) and its variables are
# injected automatically — nothing to copy by hand:
#
#   Neon Postgres  → DATABASE_URL (or POSTGRES_URL). The table is created on
#                    first use.
#   Upstash Redis  → KV_REST_API_URL + KV_REST_API_TOKEN
#                    (or UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN).
#
# The admin dashboard shows whether the database is connected. To test one
# from your machine: put these in .env, then run `npm run check:api -- --live`.
DATABASE_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=


# --- AI assistant ----------------------------------------------------------
# The customer assistant (text chat and voice calls). It is off until the
# OpenAI key below (OPENAI_API_KEY, shared with voice calls) is set, and it needs a Postgres database (DATABASE_URL or
# POSTGRES_URL above) plus ADMIN_SESSION_SECRET on Vercel. The AI uses Postgres
# for its chats, calls and spending EVEN WHEN the store above uses KV (KV_REST_*
# does not give it a database). Locally it needs neither: it keeps its records
# in a git-ignored folder (.data/).
#
# The chat uses OpenAI's chat completions API with OPENAI_API_KEY (see the voice
# section). OPENAI_CHAT_MODEL picks the model (default gpt-4.1-mini). Reasoning
# models (gpt-5*, o*) are sent AI_REASONING_EFFORT (default low) instead of a
# temperature. AI_API_URL points the chat somewhere other than api.openai.com.
OPENAI_CHAT_MODEL=
# AI_REASONING_EFFORT=
# AI_API_URL=

# Optional second model, tried once when the main one times out or fails with a
# server error (another OpenAI model). Leave empty for none.
AI_FALLBACK_MODEL=

# Prices in US$ per million tokens, used to count spend against the limits. The
# defaults (0.95 / 0.18 / 3) are above gpt-4.1-mini's and gpt-5-mini's real
# prices; set these for a larger model, or the limits will under-count. The fallback model defaults to the main model's prices.
# AI_PRICE_INPUT_PER_M=
# AI_PRICE_CACHED_PER_M=
# AI_PRICE_OUTPUT_PER_M=
# AI_FALLBACK_PRICE_INPUT_PER_M=
# AI_FALLBACK_PRICE_CACHED_PER_M=
# AI_FALLBACK_PRICE_OUTPUT_PER_M=

# Hard spending caps in US$. The lower of these and the limits set in the admin
# panel applies, so a machine can be held to a small spend whatever the panel says.
# AI_DAILY_LIMIT_USD=
# AI_MONTHLY_LIMIT_USD=

# Set to 1 to switch the whole AI off, whatever the admin panel says.
# AI_DISABLED=

# How long GET /api/ai/status keeps an answer per visitor, in seconds (default 15; 0 = never).
# AI_STATUS_CACHE_SECONDS=

# Local testing with the free practice AI (npm run dev starts it). It costs
# nothing and is recognised only when the URL is localhost AND the key is exactly
# "practice"; on Vercel it is always counted as a real, priced model. Use:
#   OPENAI_API_KEY=practice
# (the chat then goes to http://localhost:3410 by itself).
# Ports for the local servers (defaults shown):
# API_PORT=3110
# PRACTICE_AI_PORT=3410
# Set to 1 to keep the local AI database in memory instead of .data/ (tests do).
# AI_DB_MEMORY=


# --- AI voice calls --------------------------------------------------------
# Live voice calls use OpenAI's Realtime API, connected straight from the
# customer's browser. The key stays on the server: the browser sends its offer
# to /api/ai/voice, the server opens the call with OpenAI and returns only the
# answer. The call's cost counts against the same daily and monthly limits as
# the chat. Without a key the Call button is not shown.
OPENAI_API_KEY=
# OPENAI_API_KEY=practice runs free practice calls on your own computer only
# (never on Vercel): no OpenAI is called, the browser speaks with speech
# synthesis and the customer types. It needs the practice AI above (npm run dev).
#
# Optional. The defaults are shown; an unknown model is priced at the full
# model's rate so the spending limits never under-count.
# VOICE_MODEL=gpt-realtime-2.1-mini
# VOICE_VOICE=marin
# VOICE_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# VOICE_API_URL=https://api.openai.com
#
# The longest call, in seconds (default 600, between 60 and 900). The function
# that opens a call also watches it and hangs it up, so a call is fitted to the
# function's time: api/ai/[action].ts has maxDuration 300 in vercel.json (the
# Hobby plan's limit), so calls run about 4 minutes there. For 10-minute calls
# raise maxDuration to 800 on Vercel Pro. Fluid compute should also be on in the
# Vercel project settings (a long maxDuration needs it on the Hobby plan). Each
# live call keeps one function instance busy for the whole call.
# VOICE_MAX_SECONDS=600
# When Vercel does not tell the function its deadline, this is what it is
# taken to have, in seconds (default 300, the maxDuration in vercel.json).
# Raise it together with maxDuration.
# AI_FUNCTION_MAX_SECONDS=300


# --- Promotions ------------------------------------------------------------
# Optional JSON override for the promo code table. Omit to use the built-in
# codes. `percentOff` is fractional (0.1 = 10%); a whole number like 10 is also
# accepted and read as 10%.
# PROMO_CODES=[{"code":"FLEET10","percentOff":0.1,"description":"10% off fleet orders"}]


# --- Misc ------------------------------------------------------------------
# Stock level at or below which a product is flagged on the admin dashboard.
LOW_STOCK_THRESHOLD=5

# Canonical origin, used in order emails and absolute links. Defaults to the
# Vercel deployment URL.
PUBLIC_SITE_URL=https://spartantrucktyres.com.au
