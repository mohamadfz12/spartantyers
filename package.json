{
  "name": "spartan-tyres",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api,ai -c yellow,cyan,magenta \"vite\" \"npm:dev:api\" \"npm:dev:ai\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file-if-exists=.env.local --clear-screen=false scripts/dev-api.ts",
    "dev:ai": "tsx --env-file-if-exists=.env.local scripts/practice-ai.ts",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run sitemap && vite build",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "check": "node scripts/check-data.mjs",
    "check:api": "node scripts/check-api.mjs",
    "import:leads": "node scripts/import-leads.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@react-three/drei": "9.114.3",
    "@react-three/fiber": "8.17.10",
    "@vercel/functions": "3.10.1",
    "clsx": "2.1.1",
    "framer-motion": "11.11.17",
    "lucide-react": "0.454.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.27.0",
    "tailwind-merge": "2.5.4",
    "three": "0.169.0",
    "write-excel-file": "2.3.10",
    "ws": "8.22.0",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "concurrently": "10.0.6",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  },
  "engines": {
    "node": ">=20"
  }
}
